# ---------------------------------------------------------------------------
# WorkFlow Pro - Example environment configuration
#
# Copy this file to `.env` and fill in the values for your environment:
#     cp .env.example .env
#
# NEVER commit the real `.env` file. In CI these values are injected as
# encrypted secrets (see .github/workflows/qa.yml).
# ---------------------------------------------------------------------------

# --- Application under test -------------------------------------------------
BASE_URL=https://app.workflowpro.example
API_BASE_URL=https://api.workflowpro.example
TEST_ENV=staging                 # free-form label (e.g. staging, qa, dev)

# --- Browser / runtime ------------------------------------------------------
HEADLESS=true
BROWSER=chromium                 # chromium | firefox | webkit
DEFAULT_TIMEOUT=15000            # default action timeout (ms)
NAVIGATION_TIMEOUT=30000         # default navigation timeout (ms)

# --- Primary tenant / Company 1 test account --------------------------------
COMPANY1_TENANT=company1
COMPANY1_USERNAME=qa.admin@company1.test
COMPANY1_PASSWORD=change-me
COMPANY1_API_TOKEN=
TEST_OTP=                        # test-only OTP; leave blank if 2FA disabled

# TEST_USERNAME / TEST_PASSWORD are accepted as aliases for COMPANY1_* if you
# prefer generic names for a single-tenant login smoke test:
# TEST_USERNAME=
# TEST_PASSWORD=

# --- Second tenant / Company 2 (isolation tests) ----------------------------
COMPANY2_TENANT=company2
COMPANY2_USERNAME=qa.member@company2.test
COMPANY2_PASSWORD=change-me
COMPANY2_API_TOKEN=

# --- BrowserStack (optional cross-browser cloud grid) -----------------------
USE_BROWSERSTACK=false
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
